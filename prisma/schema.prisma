generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                    String           @id @db.Uuid
  schoolId              String?          @map("school_id") @db.Uuid
  branchId              String?          @map("branch_id") @db.Uuid
  role                  Role             @default(STUDENT)
  firstName             String?          @map("first_name")
  lastName              String?          @map("last_name")
  phone                 String?
  email                 String?          @unique
  avatarUrl             String?          @map("avatar_url")
  isActive              Boolean          @default(true) @map("is_active")
  status                ProfileStatus    @default(ACTIVE)
  invitationToken       String?          @unique @map("invitation_token")
  invitationExpiresAt   DateTime?        @map("invitation_expires_at")
  invitedById           String?          @map("invited_by_id") @db.Uuid
  failedLoginAttempts   Int              @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime?        @map("locked_until")
  lastLoginAt           DateTime?        @map("last_login_at")
  lastLoginIp           String?          @map("last_login_ip")
  lastLoginDevice       String?          @map("last_login_device")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  authoredAnnouncements Announcement[]
  auditLogs             AuditLog[]
  expenses              Expense[]
  leaveRequests         LeaveRequest[]
  receivedMessages      Message[]        @relation("ReceivedMessages")
  sentMessages          Message[]        @relation("SentMessages")
  notifications         Notification[]
  payments              Payment[]
  reviewedAdmissions    Admission[]
  announcementReads     AnnouncementRead[]
  branch                Branch?          @relation(fields: [branchId], references: [id])
  school                School?          @relation(fields: [schoolId], references: [id])
  staff                 Staff?
  teacher               Teacher?
  userPermissions       UserPermission[]
  meetingAttendances    MeetingAttendee[]
  createdMeetings       Meeting[]
  meetingNotes          MeetingNote[]
  createdEvents         Event[]
  eventRegistrations    EventRegistration[]
  createdCalendarEvents CalendarEvent[]

  @@index([schoolId, branchId])
  @@index([invitationToken])
  @@map("profiles")
}

model School {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  code            String            @unique
  address         String?
  phone           String?
  email           String?
  logoUrl         String?           @map("logo_url")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  sessions        AcademicSession[]
  announcements   Announcement[]
  branches        Branch[]
  classes         Class[]
  examTypes       ExamType[]
  exams           Exam[]
  expenses        Expense[]
  feeStructures   FeeStructure[]
  homework        Homework[]
  libraryBooks    LibraryBook[]
  messages        Message[]
  parents         Parent[]
  profiles        Profile[]
  settings        Setting[]
  staff           Staff[]
  students        Student[]
  subjects        Subject[]
  teachers        Teacher[]
  timetables      Timetable[]
  transportRoutes TransportRoute[]
  vehicles        Vehicle[]
  admissions      Admission[]
  meetings        Meeting[]
  events          Event[]
  calendarEvents  CalendarEvent[]

  @@map("schools")
}

model Branch {
  id              String            @id @default(uuid()) @db.Uuid
  schoolId        String            @map("school_id") @db.Uuid
  name            String
  code            String            @unique
  address         String?
  phone           String?
  email           String?
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  sessions        AcademicSession[]
  announcements   Announcement[]
  school          School            @relation(fields: [schoolId], references: [id])
  classes         Class[]
  examTypes       ExamType[]
  exams           Exam[]
  expenses        Expense[]
  feeStructures   FeeStructure[]
  homework        Homework[]
  libraryBooks    LibraryBook[]
  profiles        Profile[]
  staff           Staff[]
  students        Student[]
  subjects        Subject[]
  teachers        Teacher[]
  timetables      Timetable[]
  transportRoutes TransportRoute[]
  vehicles        Vehicle[]
  admissions      Admission[]
  meetings        Meeting[]
  events          Event[]
  calendarEvents  CalendarEvent[]

  @@index([schoolId])
  @@map("branches")
}

model AcademicSession {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @map("school_id") @db.Uuid
  branchId           String?             @map("branch_id") @db.Uuid
  name               String
  startDate          DateTime            @map("start_date")
  endDate            DateTime            @map("end_date")
  isCurrent          Boolean             @default(false) @map("is_current")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  branch             Branch?             @relation(fields: [branchId], references: [id])
  school             School              @relation(fields: [schoolId], references: [id])
  exams              Exam[]
  invoices           FeeInvoice[]
  homework           Homework[]
  reportCards        ReportCard[]
  attendanceRecords  StudentAttendance[]
  enrollments        StudentEnrollment[]
  feePlans           StudentFeePlan[]
  studentTransport   StudentTransport[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     Timetable[]
  admissions         Admission[]
  meetings           Meeting[]
  calendarEvents     CalendarEvent[]

  @@index([schoolId, branchId])
  @@map("academic_sessions")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  school    School   @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, key])
  @@map("settings")
}

model Class {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @map("school_id") @db.Uuid
  branchId           String              @map("branch_id") @db.Uuid
  name               String
  code               String
  order              Int                 @default(0)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  classSubjects      ClassSubject[]
  branch             Branch              @relation(fields: [branchId], references: [id])
  school             School              @relation(fields: [schoolId], references: [id])
  exams              Exam[]
  homework           Homework[]
  sections           Section[]
  attendanceRecords  StudentAttendance[]
  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     Timetable[]
  admissions         Admission[]
  announcements      Announcement[]
  events             Event[]

  @@unique([schoolId, branchId, code])
  @@index([schoolId, branchId])
  @@map("classes")
}

model Section {
  id                 String              @id @default(uuid()) @db.Uuid
  classId            String              @map("class_id") @db.Uuid
  name               String
  capacity           Int                 @default(30)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  homework           Homework[]
  class              Class               @relation(fields: [classId], references: [id])
  attendanceRecords  StudentAttendance[]
  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     Timetable[]
  announcements      Announcement[]
  events             Event[]

  @@unique([classId, name])
  @@map("sections")
}

model Student {
  id                  String               @id @default(uuid()) @db.Uuid
  schoolId            String               @map("school_id") @db.Uuid
  branchId            String               @map("branch_id") @db.Uuid
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  dateOfBirth         DateTime?            @map("date_of_birth")
  gender              Gender               @default(MALE)
  bloodGroup          String?              @map("blood_group")
  religion            String?
  nationality         String?
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?
  postalCode          String?              @map("postal_code")
  photoUrl            String?              @map("photo_url")
  admissionNo         String?              @map("admission_no")
  admissionDate       DateTime?            @map("admission_date")
  status              StudentStatus        @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  bookIssues          BookIssue[]
  examResults         ExamResult[]
  invoices            FeeInvoice[]
  homeworkSubmissions HomeworkSubmission[]
  reportCards         ReportCard[]
  attendance          StudentAttendance[]
  documents           StudentDocument[]
  enrollments         StudentEnrollment[]
  feePlans            StudentFeePlan[]
  parents             StudentParent[]
  transport           StudentTransport[]
  branch              Branch               @relation(fields: [branchId], references: [id])
  school              School               @relation(fields: [schoolId], references: [id])
  admission           Admission?

  @@unique([schoolId, admissionNo])
  @@index([schoolId, branchId])
  @@index([branchId, status])
  @@index([email])
  @@map("students")
}

model Parent {
  id           String             @id @default(uuid()) @db.Uuid
  schoolId     String             @map("school_id") @db.Uuid
  firstName    String             @map("first_name")
  lastName     String             @map("last_name")
  relationship ParentRelationship @default(FATHER)
  phone        String?
  email        String?
  occupation   String?
  address      String?
  isPrimary    Boolean            @default(false) @map("is_primary")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  school       School             @relation(fields: [schoolId], references: [id])
  students     StudentParent[]

  @@index([schoolId])
  @@index([email])
  @@map("parents")
}

model StudentParent {
  studentId String  @map("student_id") @db.Uuid
  parentId  String  @map("parent_id") @db.Uuid
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
}

model StudentDocument {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  documentType String   @map("document_type")
  documentName String   @map("document_name")
  filePath     String   @map("file_path")
  fileSize     Int?     @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

// ─── Admission System ──────────────────────────────────────────

enum AdmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
}

model Admission {
  id                String          @id @default(uuid()) @db.Uuid
  schoolId          String          @map("school_id") @db.Uuid
  branchId          String          @map("branch_id") @db.Uuid
  admissionNo       String          @map("admission_no")
  studentId         String?         @unique @map("student_id") @db.Uuid

  // Student Details
  firstName         String          @map("first_name")
  lastName          String          @map("last_name")
  dateOfBirth       DateTime?       @map("date_of_birth")
  gender            Gender          @default(MALE)
  bloodGroup        String?         @map("blood_group")
  religion          String?
  nationality       String?
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  postalCode        String?         @map("postal_code")
  photoUrl          String?         @map("photo_url")

  // Admission Details
  appliedClassId    String          @map("applied_class_id") @db.Uuid
  academicSessionId String          @map("academic_session_id") @db.Uuid
  previousSchool    String?         @map("previous_school")
  previousClass     String?         @map("previous_class")
  reason            String?

  // Status & Review
  status            AdmissionStatus @default(PENDING)
  reviewedById      String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?       @map("reviewed_at")
  rejectionReason   String?         @map("rejection_reason")
  approvedAt        DateTime?       @map("approved_at")

  // Timestamps
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Relations
  school            School          @relation(fields: [schoolId], references: [id])
  branch            Branch          @relation(fields: [branchId], references: [id])
  appliedClass      Class           @relation(fields: [appliedClassId], references: [id])
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  student           Student?        @relation(fields: [studentId], references: [id])
  reviewedBy        Profile?        @relation(fields: [reviewedById], references: [id])
  documents         AdmissionDocument[]
  guardians         AdmissionGuardian[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, branchId])
  @@index([status])
  @@index([academicSessionId])
  @@index([appliedClassId])
  @@map("admissions")
}

model AdmissionDocument {
  id           String    @id @default(uuid()) @db.Uuid
  admissionId  String    @map("admission_id") @db.Uuid
  documentType String    @map("document_type")
  documentName String    @map("document_name")
  filePath     String    @map("file_path")
  fileSize     Int?      @map("file_size")
  createdAt    DateTime  @default(now()) @map("created_at")
  admission    Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@map("admission_documents")
}

model AdmissionGuardian {
  id             String             @id @default(uuid()) @db.Uuid
  admissionId    String             @map("admission_id") @db.Uuid
  firstName      String             @map("first_name")
  lastName       String             @map("last_name")
  relationship   ParentRelationship @default(FATHER)
  phone          String?
  email          String?
  occupation     String?
  address        String?
  isPrimary      Boolean            @default(false) @map("is_primary")
  createdAt      DateTime           @default(now()) @map("created_at")
  admission      Admission          @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@map("admission_guardians")
}

model StudentEnrollment {
  id                String          @id @default(uuid()) @db.Uuid
  studentId         String          @map("student_id") @db.Uuid
  classId           String          @map("class_id") @db.Uuid
  sectionId         String?         @map("section_id") @db.Uuid
  academicSessionId String          @map("academic_session_id") @db.Uuid
  rollNumber        String?         @map("roll_number")
  enrollmentDate    DateTime        @default(now()) @map("enrollment_date")
  status            StudentStatus   @default(ACTIVE)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  class             Class           @relation(fields: [classId], references: [id])
  section           Section?        @relation(fields: [sectionId], references: [id])
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicSessionId])
  @@index([sectionId])
  @@index([academicSessionId])
  @@index([classId])
  @@map("student_enrollments")
}

model Teacher {
  id             String              @id @default(uuid()) @db.Uuid
  schoolId       String              @map("school_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  profileId      String?             @unique @map("profile_id") @db.Uuid
  employeeCode   String              @map("employee_code")
  firstName      String              @map("first_name")
  lastName       String              @map("last_name")
  phone          String?
  email          String?
  address        String?
  qualification  String?
  specialization String?
  joiningDate    DateTime?           @map("joining_date")
  status         EmployeeStatus      @default(ACTIVE)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  homework       Homework[]
  assignments    TeacherAssignment[]
  branch         Branch              @relation(fields: [branchId], references: [id])
  profile        Profile?            @relation(fields: [profileId], references: [id])
  school         School              @relation(fields: [schoolId], references: [id])
  timetableSlots Timetable[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId, branchId])
  @@index([email])
  @@map("teachers")
}

model Staff {
  id           String            @id @default(uuid()) @db.Uuid
  schoolId     String            @map("school_id") @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  profileId    String?           @unique @map("profile_id") @db.Uuid
  employeeCode String            @map("employee_code")
  firstName    String            @map("first_name")
  lastName     String            @map("last_name")
  department   String
  designation  String
  phone        String?
  email        String?
  joiningDate  DateTime?         @map("joining_date")
  status       EmployeeStatus    @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  branch       Branch            @relation(fields: [branchId], references: [id])
  profile      Profile?          @relation(fields: [profileId], references: [id])
  school       School            @relation(fields: [schoolId], references: [id])
  attendance   StaffAttendance[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId, branchId])
  @@map("staff")
}

model Subject {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @map("school_id") @db.Uuid
  branchId           String              @map("branch_id") @db.Uuid
  name               String
  code               String
  type               SubjectType         @default(CORE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  classSubjects      ClassSubject[]
  exams              Exam[]
  homework           Homework[]
  branch             Branch              @relation(fields: [branchId], references: [id])
  school             School              @relation(fields: [schoolId], references: [id])
  teacherAssignments TeacherAssignment[]
  timetableSlots     Timetable[]

  @@unique([schoolId, branchId, code])
  @@index([schoolId, branchId])
  @@map("subjects")
}

model ClassSubject {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  class     Class    @relation(fields: [classId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

model TeacherAssignment {
  id                String          @id @default(uuid()) @db.Uuid
  teacherId         String          @map("teacher_id") @db.Uuid
  classId           String          @map("class_id") @db.Uuid
  sectionId         String?         @map("section_id") @db.Uuid
  subjectId         String          @map("subject_id") @db.Uuid
  academicSessionId String          @map("academic_session_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  class             Class           @relation(fields: [classId], references: [id])
  section           Section?        @relation(fields: [sectionId], references: [id])
  subject           Subject         @relation(fields: [subjectId], references: [id])
  teacher           Teacher         @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, classId, sectionId, subjectId, academicSessionId])
  @@index([teacherId])
  @@index([classId, sectionId])
  @@index([academicSessionId])
  @@map("teacher_assignments")
}

model Timetable {
  id                String          @id @default(uuid()) @db.Uuid
  schoolId          String          @map("school_id") @db.Uuid
  branchId          String          @map("branch_id") @db.Uuid
  classId           String          @map("class_id") @db.Uuid
  sectionId         String?         @map("section_id") @db.Uuid
  subjectId         String          @map("subject_id") @db.Uuid
  teacherId         String          @map("teacher_id") @db.Uuid
  dayOfWeek         DayOfWeek       @map("day_of_week")
  startTime         String          @map("start_time")
  endTime           String          @map("end_time")
  room              String?
  academicSessionId String          @map("academic_session_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  branch            Branch          @relation(fields: [branchId], references: [id])
  class             Class           @relation(fields: [classId], references: [id])
  school            School          @relation(fields: [schoolId], references: [id])
  section           Section?        @relation(fields: [sectionId], references: [id])
  subject           Subject         @relation(fields: [subjectId], references: [id])
  teacher           Teacher         @relation(fields: [teacherId], references: [id])

  @@index([classId, sectionId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([academicSessionId])
  @@map("timetables")
}

model StudentAttendance {
  id                String           @id @default(uuid()) @db.Uuid
  studentId         String           @map("student_id") @db.Uuid
  classId           String           @map("class_id") @db.Uuid
  sectionId         String?          @map("section_id") @db.Uuid
  academicSessionId String           @map("academic_session_id") @db.Uuid
  date              DateTime         @db.Date
  status            AttendanceStatus
  markedById        String           @map("marked_by_id") @db.Uuid
  remarks           String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  academicSession   AcademicSession  @relation(fields: [academicSessionId], references: [id])
  class             Class            @relation(fields: [classId], references: [id])
  section           Section?         @relation(fields: [sectionId], references: [id])
  student           Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, date, academicSessionId])
  @@index([classId, sectionId, date])
  @@index([studentId, date])
  @@map("student_attendance")
}

model StaffAttendance {
  id        String           @id @default(uuid()) @db.Uuid
  staffId   String           @map("staff_id") @db.Uuid
  date      DateTime         @db.Date
  checkIn   DateTime?        @map("check_in")
  checkOut  DateTime?        @map("check_out")
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now()) @map("created_at")
  staff     Staff            @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
  @@map("staff_attendance")
}

model LeaveRequest {
  id         String      @id @default(uuid()) @db.Uuid
  profileId  String      @map("profile_id") @db.Uuid
  leaveType  LeaveType   @map("leave_type")
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy String?     @map("approved_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  profile    Profile     @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@index([status])
  @@index([approvedBy])
  @@map("leave_requests")
}

model FeeStructure {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  branchId     String           @map("branch_id") @db.Uuid
  name         String
  amount       Decimal
  frequency    FeeFrequency     @default(MONTHLY)
  category     FeeCategory      @default(TUITION)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  invoiceItems FeeInvoiceItem[]
  branch       Branch           @relation(fields: [branchId], references: [id])
  school       School           @relation(fields: [schoolId], references: [id])
  feePlans     StudentFeePlan[]

  @@index([schoolId, branchId])
  @@map("fee_structures")
}

model StudentFeePlan {
  id                String          @id @default(uuid()) @db.Uuid
  studentId         String          @map("student_id") @db.Uuid
  feeStructureId    String          @map("fee_structure_id") @db.Uuid
