# Supabase
# https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ID Card QR token HMAC secret (REQUIRED in production — no fallback is used)
ID_CARD_TOKEN_SECRET=your-long-random-secret

# Database
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.your-project:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (used for migrations)
DIRECT_URL="postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# WhatsApp Business API (Optional)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_KEY=your-whatsapp-business-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ─── Demo / Trial subsystem ──────────────────────────────────────────────
# Every variable here is OPTIONAL and has a safe default, so upgrading the code
# never breaks a running deployment. Read by lib/demo/env.ts (server-only).
#
# DEMO_DISABLED is the kill switch. It defaults to TRUE: the demo is dark until
# you explicitly turn it on. Flip it to false to enable; flip it back to true to
# disable every demo entry point without a deploy.
DEMO_DISABLED=true

# Shared password for the four demo personas (admin/teacher/student/parent).
# Required (min 12 chars) when DEMO_DISABLED=false. It is intentionally public —
# it is shown on the /demo landing page — so demo data must be fictional,
# read-mostly, short-lived, and auto-purged. Never reuse a real credential here.
DEMO_PERSONA_PASSWORD=change-me-to-12-plus-chars

# Circuit breaker: refuse new demo requests once this many tenants are active.
DEMO_MAX_ACTIVE_TENANTS=25

# Plan applied to public /demo requests. Must match a Plan.key in the catalog.
DEMO_DEFAULT_PLAN_KEY=DEMO

# Caps on self-serve trial extensions.
DEMO_MAX_EXTENSION_MINUTES=1440
DEMO_RETENTION_DAYS=2

# Purge tenants nobody has returned to, and reap abandoned in-flight seeds.
DEMO_IDLE_PURGE_HOURS=72
DEMO_STALE_SEED_MINUTES=10

# Guards scripts/demo-seed.ts so it cannot be pointed at production casually.
DEMO_SEED_ALLOW=false

# Authenticates GET /api/cron/demo-purge. The route 404s in production if unset.
CRON_SECRET=your-cron-secret

# CAPTCHA on the public /demo form (reCAPTCHA v3 style score in, verify out).
# Fails closed: without it the public request action is unavailable.
DEMO_CAPTCHA_SECRET=your-captcha-secret
NEXT_PUBLIC_DEMO_CAPTCHA_SITE_KEY=your-captcha-site-key
